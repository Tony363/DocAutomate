# FastAPI configuration
API_PORT=8000
DEBUG=false

# Claude CLI integration
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT=120
CLAUDE_AUTO_GRANT_FILE_ACCESS=true

# Storage directories
STORAGE_DIR=./storage
STATE_DIR=./state
LOG_DIR=./logs

# Feature toggles
ENABLE_WORKFLOW_AUTORUN=true
ALLOW_FILE_UPLOADS=true
